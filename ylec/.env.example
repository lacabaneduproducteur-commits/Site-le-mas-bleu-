# Adresse du service d'envoi du formulaire de devis (compatible Formspree).
# Exemple : https://formspree.io/f/abcdwxyz
# Laisser vide : le formulaire ouvre la messagerie du visiteur avec la demande pré-remplie.
VITE_FORM_ENDPOINT=

# Passer à true uniquement si le service configuré accepte les pièces jointes.
VITE_FORM_ALLOW_FILES=false
